# This _headers file works for Netlify and Cloudflare. For other providers, you may want to configure these headers yourself, depending on your setup.

# TanStack Start generated assets (hash-based filenames)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Plain-text files for crawlers and agents: short cache so edits show up fast.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
